<UserControl x:Class="CleanSlate.Views.CatalogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Premier écran : les tuiles à cocher, rangées par famille. -->
    <Grid Margin="28,22,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titre de la famille + recherche -->
        <Grid Margin="0,0,10,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PageHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="13"
                           Margin="0,4,0,0" MaxHeight="38" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Top">
            <Grid Width="230" Height="36">
                <TextBox Style="{StaticResource SearchBox}" Padding="34,8,10,8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Cherche dans tout le catalogue : un nom (« steam ») ou un usage (« pdf », « vpn »)." />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" Margin="12,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" HorizontalAlignment="Left" />
                <TextBlock Text="Rechercher un logiciel" Margin="35,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <!-- « 23 déjà installés » : un clic les montre (et permet d'en réinstaller un si la détection s'est trompée) -->
            <Button Style="{StaticResource LinkButton}" Content="{Binding InstalledLink}" HorizontalAlignment="Right" Margin="0,6,2,0"
                    Command="{Binding ToggleInstalledViewCommand}"
                    Visibility="{Binding InstalledLink, Converter={StaticResource EqualsToVis}, ConverterParameter=!}"
                    ToolTip="Les logiciels du catalogue que l'appli a reconnus sur ce PC." />
            </StackPanel>
        </Grid>

        <!-- Avertissement si winget est absent -->
        <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Margin="0,0,10,14" Padding="16,14"
                Visibility="{Binding WingetWarning, Converter={StaticResource EqualsToVis}, ConverterParameter=!}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Revérifier" Command="{Binding RecheckWingetCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Activer winget" Padding="16,9" Margin="8,0,0,0"
                            Command="{Binding EnableWingetCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding WingetWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Les tuiles. Un clic n'importe où sur une tuile la coche. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
            <!-- Les packs : un clic coche tout un lot. Seulement sur la première page. -->
            <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowPacks, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Packs prêts à cocher" FontSize="12.5" FontWeight="SemiBold" Margin="2,4,12,8"
                           Foreground="{StaticResource TextMutedBrush}" />
                <ItemsControl ItemsSource="{Binding Packs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PackChip}"
                                    Command="{Binding DataContext.TogglePackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <DockPanel Margin="2,4,12,8" LastChildFill="False">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Tout cocher / décocher"
                                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource AppTile}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Rien à afficher (recherche sans résultat, sélection vide) -->
        <TextBlock Grid.Row="2" Text="{Binding EmptyText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="420"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding EmptyText, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />

        <!-- Barre d'action : toujours visible, c'est l'action principale de l'appli -->
        <Border Grid.Row="3" Margin="0,12,10,0" Padding="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Suivant"
                        Padding="34,12" FontSize="15" Command="{Binding InstallCommand}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionText}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Tout décocher" Margin="16,0,0,0"
                        Command="{Binding ClearSelectionCommand}" />
                <!-- La sélection dans un fichier : pour la prochaine réinstallation, ou pour un ami -->
                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Enregistrer la sélection" Margin="14,0,0,0"
                        Command="{Binding SaveSelectionCommand}"
                        ToolTip="Garde la liste de ce que tu as coché dans un fichier, à rouvrir plus tard ou à envoyer à quelqu'un." />
                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Ouvrir une sélection" Margin="8,0,0,0"
                        Command="{Binding OpenSelectionCommand}"
                        ToolTip="Recoche d'un coup les logiciels d'un fichier de sélection enregistré." />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
