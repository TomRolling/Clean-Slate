<UserControl x:Class="CleanSlate.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Deuxième écran : « Où installer ? ». Une ligne par logiciel coché, avec son dossier. -->
    <Grid Margin="28,22,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,10,14">
            <TextBlock Text="{Binding ReviewTitle}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReviewHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Réglage groupé -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                    Visibility="{Binding Choosable.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=!0}">
            <Button Style="{StaticResource GhostButton}" Content="Même dossier pour tous…" Command="{Binding ChooseFolderForAllCommand}"
                    ToolTip="Choisis un dossier une seule fois : chaque logiciel qui l'accepte ira dans un sous-dossier à son nom." />
            <Button Style="{StaticResource GhostButton}" Content="Tout remettre à l'emplacement habituel" Margin="8,0,0,0"
                    Command="{Binding ResetFoldersCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Choosable}" Focusable="False" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorder}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppLogo}" Focusable="False" />
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <!-- Le disque visé et la place qu'il lui reste ; en orange s'il est presque plein -->
                                    <TextBlock Text="{Binding DriveText}" FontSize="12" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DriveIsLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- L'emplacement est un bouton : un clic ouvre le sélecteur de dossier de Windows -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LinkButton}" Content="Remettre par défaut" Margin="0,0,10,0"
                                            Visibility="{Binding HasCustomLocation, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ResetFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" MaxWidth="330"
                                            ToolTip="Clique pour choisir un autre dossier. Le logiciel ira dans un sous-dossier à son nom."
                                            Command="{Binding DataContext.ChooseFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding LocationShort}" ToolTip="{Binding LocationText}" MaxWidth="290">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCustomLocation}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Les logiciels qui ne laissent pas le choix : une simple phrase, pour ne pas encombrer la liste -->
        <TextBlock Grid.Row="3" Text="{Binding FixedText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12.5"
                   Margin="2,10,10,0" MaxHeight="52"
                   Visibility="{Binding FixedText, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />

        <Border Grid.Row="4" Margin="0,12,10,0" Padding="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Lancer l'installation"
                        Padding="26,12" FontSize="15" Command="{Binding StartInstallCommand}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Retour à la liste"
                        Command="{Binding BackToCatalogueCommand}" />
                <!-- Place libre sur le disque de Windows, où vont tous les logiciels sans dossier choisi -->
                <TextBlock Text="{Binding DiskText}" FontSize="12.5" Margin="16,0" VerticalAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiskIsLow}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
