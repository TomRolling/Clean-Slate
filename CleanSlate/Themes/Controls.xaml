<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CleanSlate.Controls"
                    xmlns:m="clr-namespace:CleanSlate.Models">

    <!-- Convertisseurs utilisés par les vues -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <c:EqualsToVisibilityConverter x:Key="EqualsToVis" />
    <c:StatusToBrushConverter x:Key="StatusBrush" />
    <c:StatusToGlyphConverter x:Key="StatusGlyph" />

    <!-- ═════════════ Textes ═════════════ -->

    <Style x:Key="HeadlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmallMutedText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═════════════ Barre latérale ═════════════ -->

    <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" Margin="10,1" Padding="0,6">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                    Visibility="Hidden" />
                            <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Contour de sélection au clavier ═════════════ -->
    <!-- Windows ne l'affiche que quand on navigue avec la touche Tab, jamais à la souris. -->

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource AccentHoverBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="999" BorderThickness="2" BorderBrush="{StaticResource AccentHoverBrush}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Boutons ═════════════ -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton discret : simple contour -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Carte cliquable (accueil, outils de réparation) -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton « lien » : juste du texte, pour les actions secondaires (« Tout cocher », « Remettre par défaut ») -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═════════════ Logo d'un logiciel ═════════════ -->
    <!-- Le vrai logo sur une plaque claire (beaucoup de logos sont sombres et disparaîtraient sur le fond noir).
         S'il n'y a pas de logo : une pastille de couleur avec l'initiale. -->

    <DataTemplate x:Key="AppLogo">
        <Grid Width="36" Height="36">
            <Border x:Name="Initials" CornerRadius="9" Background="{Binding Tint}">
                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Plate" CornerRadius="9" Background="#F1F3F6" Visibility="Collapsed">
                <Image Source="{Binding LogoUri}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding LogoUri, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" Value="Visible">
                <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                <Setter TargetName="Initials" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═════════════ Tuile d'un logiciel du catalogue ═════════════ -->
    <!-- Toute la tuile est une case à cocher. Elle lit directement le logiciel (AppItem) qu'on lui donne :
         logo, nom, description, et un rond qui se coche. -->

    <Style x:Key="AppTile" TargetType="ToggleButton">
        <Setter Property="Width" Value="238" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTip" Value="{Binding Tip}" />
        <!-- Nom lu par les lecteurs d'écran (le texte d'un modèle de contrôle ne l'est pas tout seul) -->
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppLogo}" Focusable="False"
                                            VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="11,0,8,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <!-- Devant la description : « Compte · », « Essai · » ou « Payant · » quand ce n'est pas simplement gratuit -->
                                <TextBlock x:Name="Sub" FontSize="11.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" MaxHeight="31" LineHeight="15" LineStackingStrategy="BlockLineHeight">
                                    <Run x:Name="AccessRun" Text="{Binding AccessLabel, Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextBrush}" /><Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock x:Name="Installed" Text="{Binding InstalledText}" FontSize="11.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource OkBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <Border x:Name="Box" Grid.Column="2" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="{StaticResource ControlBorderBrush}" VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 4,9 L 7.5,12.5 L 13,5" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Access}" Value="Paid">
                            <Setter TargetName="AccessRun" Property="Foreground" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Access}" Value="Trial">
                            <Setter TargetName="AccessRun" Property="Foreground" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                        <!-- Déjà sur le PC : « Déjà installé » remplace la description -->
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Installed" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- …et tant qu'on ne la coche pas : tuile atténuée, coche verte. Un clic la coche quand même
                             (« Sera installé quand même »), au cas où la détection se serait trompée. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                <Condition Binding="{Binding IsSelected}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource OkBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OkBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Pastille d'un pack ═════════════ -->
    <!-- Un bouton arrondi « icône + nom ». Il s'allume quand tout le pack est coché (Pack.IsActive). -->

    <Style x:Key="PackChip" TargetType="Button">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTip" Value="{Binding Tip}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat=Pack {0}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource CardBackgroundBrush}" CornerRadius="17" Height="34"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="13,0,15,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AccentHoverBrush}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Le gros bouton rond animé ═════════════ -->

    <Style TargetType="{x:Type c:RingButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RingButton}">
                    <Viewbox>
                        <Grid x:Name="Root" Width="100" Height="100" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!-- Disque central -->
                            <Ellipse x:Name="Disc" Margin="10" Fill="{StaticResource CardBackgroundBrush}" />
                            <!-- Piste grise (visible pendant une opération) -->
                            <Ellipse Margin="4" Stroke="{StaticResource BorderBrush}" StrokeThickness="5" />
                            <!-- Anneau bleu plein, au repos -->
                            <Ellipse x:Name="IdleRing" Margin="4" Stroke="{StaticResource AccentBrush}" StrokeThickness="5" />
                            <!-- Arc de progression -->
                            <Path x:Name="Arc" Data="{TemplateBinding ArcGeometry}" Visibility="Hidden"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <!-- Trait fin qui tourne pendant une opération -->
                            <Ellipse x:Name="Spinner" Opacity="0" Stroke="{StaticResource AccentHoverBrush}"
                                     StrokeThickness="1.4" StrokeDashArray="45 180" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Coche (ou triangle) affichée seulement quand une action vient de se terminer -->
                                <TextBlock x:Name="OutcomeGlyph" HorizontalAlignment="Center" FontSize="17" Margin="0,0,0,2"
                                           FontFamily="{StaticResource IconFont}" Visibility="Collapsed"
                                           Text="{Binding Outcome, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusGlyph}}"
                                           Foreground="{Binding Outcome, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusBrush}}" />
                                <TextBlock x:Name="MainText" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock x:Name="CaptionText" HorizontalAlignment="Center" FontSize="7.6" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{TemplateBinding Caption}" />
                            </StackPanel>
                        </Grid>
                    </Viewbox>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Caption" Value="">
                            <Setter TargetName="CaptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource HoverBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" To="1.05" Duration="0:0:0.15"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                        <DoubleAnimation Storyboard.TargetName="Root" To="1.05" Duration="0:0:0.15"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" To="1" Duration="0:0:0.15"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                        <DoubleAnimation Storyboard.TargetName="Root" To="1" Duration="0:0:0.15"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Action terminée : anneau vert (tout s'est bien passé) ou orange (une partie a échoué), coche,
                             et un seul battement pour attirer l'œil. Rien ne tourne ensuite. -->
                        <Trigger Property="Outcome" Value="{x:Static m:Status.Ok}">
                            <Setter TargetName="IdleRing" Property="Stroke" Value="{StaticResource OkBrush}" />
                            <Setter TargetName="OutcomeGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MainText" Property="FontSize" Value="9.5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" From="1" To="1.1" Duration="0:0:0.18" AutoReverse="True"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                        <DoubleAnimation Storyboard.TargetName="Root" From="1" To="1.1" Duration="0:0:0.18" AutoReverse="True"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="Outcome" Value="{x:Static m:Status.Warning}">
                            <Setter TargetName="IdleRing" Property="Stroke" Value="{StaticResource WarningBrush}" />
                            <Setter TargetName="OutcomeGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MainText" Property="FontSize" Value="9.5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" From="1" To="1.1" Duration="0:0:0.18" AutoReverse="True"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                        <DoubleAnimation Storyboard.TargetName="Root" From="1" To="1.1" Duration="0:0:0.18" AutoReverse="True"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>

                        <!-- Pendant une opération : l'anneau plein laisse place à l'arc et au trait qui tourne.
                             L'animation est arrêtée dès que l'opération se termine (rien ne tourne au repos). -->
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="IdleRing" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Arc" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Spinner" Property="Opacity" Value="1" />
                            <Setter TargetName="MainText" Property="FontSize" Value="15" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Spinner" From="0" To="360" Duration="0:0:1.3"
                                                         RepeatBehavior="Forever"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Écran de départ d'un onglet : gros bouton centré, tant qu'on n'a pas encore analysé ═════════════ -->

    <DataTemplate x:Key="StartHero">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <c:RingButton Width="190" Height="190"
                          Command="{Binding RingCommand}" IsBusy="{Binding IsBusy}" Progress="{Binding Progress}"
                          Content="{Binding RingText}" Caption="{Binding RingCaption}" Outcome="{Binding Outcome}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,26,0,0" />
            <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" MaxHeight="60" />
        </StackPanel>
    </DataTemplate>

    <!-- ═════════════ Icône d'état (tourne quand « en cours ») ═════════════ -->

    <Style x:Key="StatusIcon" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock x:Name="Glyph" Width="20" Height="20" TextAlignment="Center" FontSize="17" LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"
                               FontFamily="{StaticResource IconFont}" RenderTransformOrigin="0.5,0.5"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusGlyph}}"
                               Foreground="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusBrush}}">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Static m:Status.Working}">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="WorkingStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph" From="0" To="360" Duration="0:0:1.1"
                                                         RepeatBehavior="Forever"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="WorkingStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Case à cocher ═════════════ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="{StaticResource ControlBorderBrush}" Background="Transparent">
                            <Path x:Name="Mark" Data="M 4,9 L 7.5,12.5 L 13,5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Interrupteur (programmes au démarrage) ═════════════ -->

    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="42" Height="24" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="#3A404C" />
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" To="18" Duration="0:0:0.15"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" />
                                        <ColorAnimation Storyboard.TargetName="Track" To="#4C8DF6" Duration="0:0:0.15"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" To="0" Duration="0:0:0.15"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" />
                                        <ColorAnimation Storyboard.TargetName="Track" To="#3A404C" Duration="0:0:0.15"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Barre de progression ═════════════ -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Sous-onglets en « pastilles » ═════════════ -->

    <Style x:Key="SegmentedItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="16" Padding="14,7" Margin="0,0,6,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedTabs" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BorderBrush}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=!}">
                            <TextBlock Text="{Binding Badge}" FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Listes ═════════════ -->

    <!-- Ligne de liste : fond qui s'éclaire au survol -->
    <Style x:Key="RowBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,11" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Style="{StaticResource RowBorder}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Longue liste (virtualisée : seules les lignes visibles sont créées) -->
    <Style x:Key="RowList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- ═════════════ Zones de texte ═════════════ -->

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <!-- Pas de marge ici : la zone de texte applique déjà son Padding toute seule. Le compter deux
                             fois ne laissait que 2 pixels de haut au texte, qui devenait invisible. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Journal (sortie de winget, sfc, dism) -->
    <Style x:Key="LogBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="c:Behaviors.AutoScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="#0C0E12" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,10" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════ Barres de défilement fines et sombres ═════════════ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" Background="#353B47" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#566070" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Margin="0,2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═════════════ Info-bulles ═════════════ -->

    <!-- Coins arrondis, et surtout retour à la ligne : les explications longues ne partent plus sur toute la largeur de l'écran. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SelectedBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,9">
                        <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
